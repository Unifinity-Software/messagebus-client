<Project Sdk="Microsoft.NET.Sdk">

  <!-- The reusable mbus command implementation; MessageBus.Cli.Tool is the executable. -->
  <PropertyGroup>
    <PackageId>MessageBus.Ai.Cli.Core</PackageId>
    <IsPackable>true</IsPackable>
    <Description>The reusable implementation of the messagebus.ai mbus command.</Description>
    <AssemblyName>MessageBus.Cli</AssemblyName>
    <RootNamespace>MessageBus.Cli</RootNamespace>
    <!-- Release builds opt in explicitly, even when Version equals MbusSourceVersion.
         Keep source revision separate so the version command prints a single SemVer value. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CredentialFreeProxy.cs" Link="Http\CredentialFreeProxy.cs" />
    <InternalsVisibleTo Include="MessageBus.Cli.Tests" />
    <InternalsVisibleTo Include="mbus.ScmFixture" />
  </ItemGroup>

  <Target Name="MbusBuildMetadata" BeforeTargets="GetAssemblyAttributes"
          DependsOnTargets="GetAssemblyVersion;InitializeSourceControlInformation">
    <PropertyGroup Condition="'$(MbusReleaseBuild)' != 'true'">
      <_MbusCommit Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</_MbusCommit>
      <_MbusCommit Condition="'$(_MbusCommit)' != '' and $(_MbusCommit.Length) &gt; 7">$(_MbusCommit.Substring(0, 7))</_MbusCommit>
      <_MbusDevVersion>$(Version.Split('+')[0])+dev</_MbusDevVersion>
      <InformationalVersion>$(_MbusDevVersion)</InformationalVersion>
      <InformationalVersion Condition="'$(_MbusCommit)' != ''">$(_MbusDevVersion).$(_MbusCommit)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="MbusSourceRevision" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
      <AssemblyMetadata Include="MbusImageManaged" Value="true" Condition="'$(MbusImageManaged)' == 'true'" />
    </ItemGroup>
  </Target>

  <!-- the original issue: the public key releases are signed with (ECDSA P-256, SubjectPublicKeyInfo base64), built in
       by the release build: -p:MbusReleasePublicKey=<base64>. Development builds have none (Update/README.md). -->
  <ItemGroup Condition="'$(MbusReleasePublicKey)' != ''">
    <AssemblyMetadata Include="MbusReleasePublicKey" Value="$(MbusReleasePublicKey)" />
  </ItemGroup>

  <!-- the original issue: the Apple team whose Developer ID signs macOS releases (-p:MbusAppleTeamId=<10 characters>). A build signed
       by that team keeps the machine key where only mbus can read it (Security/MacKeychain.cs). -->
  <ItemGroup Condition="'$(MbusAppleTeamId)' != ''">
    <AssemblyMetadata Include="MbusAppleTeamId" Value="$(MbusAppleTeamId)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
    <!-- DPAPI for the machine key on Windows (the original issue). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MessageBus.Contracts\MessageBus.Contracts.csproj" />
    <ProjectReference Include="..\MessageBus.Runner.Transport\MessageBus.Runner.Transport.csproj" />
    <!-- The local MCP server behind `mbus mcp` (the original issue), and the runner's decrypted bundles. -->
    <ProjectReference Include="..\MessageBus.Mcp\MessageBus.Mcp.csproj" />
  </ItemGroup>

  <!-- The orchestrate skill (the original issue) is built into mbus, so `mbus connect` installs it from the single
       file. Until skills/mbus-orchestrate has files this matches nothing and connect says so. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\skills\mbus-orchestrate\**\*"
                      LogicalName="skills/mbus-orchestrate/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)PACKAGE.Core.md" Pack="true" PackagePath="/README.md" Visible="false" />
  </ItemGroup>

</Project>
