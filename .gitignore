## .NET .gitignore, trimmed from `dotnet new gitignore`.

# dotenv files
.env

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
# ...but source folders named Releases are not build output
!src/**/Releases/
!tests/**/Releases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
out/

# Visual Studio cache/options directory
.vs/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
test-results/

# .NET
project.lock.json
project.fragment.lock.json
artifacts/

# Files built by Visual Studio
*.pdb
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.svclog

# Publish output
publish/
PublishScripts/
*.[Pp]ublish.xml
*.pubxml
*.publishproj
*.publishsettings

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Coverage
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# Python cache files
__pycache__/
*.pyc

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Vim temporary swap files
*.swp

# Agent worktrees
.claude/worktrees/

# Never commit signing keys
*.pem
