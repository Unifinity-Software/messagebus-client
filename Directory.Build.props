<Project>
  <PropertyGroup>
    <MbusSourceVersion>1.1.1</MbusSourceVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Nothing is a package unless it is named below: tests and the fake agent stay unpackable. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- The eight packages from this repository: seven libraries and the mbus tool. All are MIT-licensed. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MessageBus.Contracts' Or '$(MSBuildProjectName)' == 'MessageBus.Crypto' Or '$(MSBuildProjectName)' == 'MessageBus.Runner.Transport' Or '$(MSBuildProjectName)' == 'MessageBus.Attachments.Client' Or '$(MSBuildProjectName)' == 'MessageBus.Mcp' Or '$(MSBuildProjectName)' == 'MessageBus.Cli' Or '$(MSBuildProjectName)' == 'MessageBus.Testing' Or '$(MSBuildProjectName)' == 'MessageBus.Cli.Tool'">
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Unifinity Software Corporation</Copyright>
    <RepositoryUrl>https://github.com/Unifinity-Software/messagebus-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <!-- Library package metadata, with a symbol package (.snupkg) beside each one. The mbus tool keeps its own
       metadata in its project file and ships without a symbol package. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MessageBus.Contracts' Or '$(MSBuildProjectName)' == 'MessageBus.Crypto' Or '$(MSBuildProjectName)' == 'MessageBus.Runner.Transport' Or '$(MSBuildProjectName)' == 'MessageBus.Attachments.Client' Or '$(MSBuildProjectName)' == 'MessageBus.Mcp' Or '$(MSBuildProjectName)' == 'MessageBus.Cli' Or '$(MSBuildProjectName)' == 'MessageBus.Testing'">
    <Version>$(MbusSourceVersion)</Version>
    <Authors>Unifinity Software Corporation</Authors>
    <Company>Unifinity Software Corporation</Company>
    <Product>messagebus.ai</Product>
    <PackageProjectUrl>https://messagebus.ai</PackageProjectUrl>
    <PackageTags>messagebus.ai;mbus;mcp;coding-agents</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MessageBus.Cli.Tool'">
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'MessageBus.Contracts' Or '$(MSBuildProjectName)' == 'MessageBus.Crypto' Or '$(MSBuildProjectName)' == 'MessageBus.Runner.Transport' Or '$(MSBuildProjectName)' == 'MessageBus.Attachments.Client' Or '$(MSBuildProjectName)' == 'MessageBus.Mcp' Or '$(MSBuildProjectName)' == 'MessageBus.Cli' Or '$(MSBuildProjectName)' == 'MessageBus.Testing'">
    <None Include="$(MSBuildThisFileDirectory)brand/icons/icon-128.png" Pack="true" PackagePath="/icon.png" Visible="false" />
  </ItemGroup>
</Project>
