  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MessageBus.Contracts\MessageBus.Contracts.csproj" />
  </ItemGroup>

</Project>
