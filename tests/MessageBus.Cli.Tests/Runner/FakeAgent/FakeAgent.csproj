<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for `claude -p` and `codex exec` in the runner tests (the original issue): it prints the same JSON
       the real CLIs print, so the runner's real launch and parsing code runs and no real agent is
       ever called. The test project copies it next to its own output. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>fake-agent</AssemblyName>
    <RootNamespace>MessageBus.Cli.Tests.FakeAgent</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\MessageBus.Testing\MessageBus.Testing.csproj" />
  </ItemGroup>

</Project>
